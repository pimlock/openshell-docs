---
// Title + page actions + description.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import PageActions from '../PageActions.astro';
import Mermaid from '../Mermaid.astro';
const { description } = Astro.locals.starlightRoute.entry.data;
---

<div class="os-title">
  <Default />
  <PageActions />
</div>
{description && <p class="os-lede">{description}</p>}
<Mermaid />
