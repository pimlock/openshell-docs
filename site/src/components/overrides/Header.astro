---
// Header: wordmark / search / theme, then topic tabs, then (in topics with
// several docsets) sub-tabs for the topic's overview and each docset.
// Tab and sub-tab links come from src/routeData.ts and follow the current
// page's version context.
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import SocialIcons from 'virtual:starlight/components/SocialIcons';

const topics = (Astro.locals as any).osVersion?.topics ?? [];
const fragment = !!(Astro.locals as any).osVersion?.fragment;
// A fragment preview names its docset in the header: "OpenShell Docker Driver".
const name = fragment ? (Astro.locals as any).osVersion?.name : undefined;
const ds = (Astro.locals as any).osVersion?.docsets;
const subtabs = ds
  ? [
      ...(ds.topic.landing ? [{ label: 'Overview', href: ds.topic.landing, current: ds.topic.isLanding }] : []),
      ...ds.items.map((d: any) => ({
        label: d.title, href: d.href, current: d.current,
      })),
    ]
  : [];
---

<div class:list={['os-header', { 'os-header--fragment': fragment }]}>
  <div class="os-header__row">
    <a href={import.meta.env.BASE_URL} class="os-wordmark" translate="no">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="os-wordmark__mark"><rect width="24" height="24" rx="5" fill="#76b900"/><path d="M7 8.5 11 12l-4 3.5M12.5 16H17" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>OpenShell{name && <span class="os-wordmark__docset"> {name}</span>}</span>
    </a>
    <div class="os-header__search print:hidden"><Search /></div>
    <div class="os-header__end print:hidden">
      <div class="sl-hidden md:sl-flex os-header__social"><SocialIcons /></div>
      <div class="sl-hidden md:sl-flex"><ThemeSelect /></div>
    </div>
  </div>
  {!fragment && (
    <nav class="os-tabs print:hidden" aria-label="Topics">
      {topics.map((t: any) => (
        <a href={t.href} class="os-tab" aria-current={t.isCurrent ? 'true' : undefined}>{t.label}</a>
      ))}
    </nav>
  )}
  {ds && ds.items.length > 1 && (
    <div class="os-subtabs print:hidden">
      <nav class="os-subtabs__links" aria-label={ds.topic.label}>
        {subtabs.map((t: any) => (
          <a href={t.href} class="os-subtab" aria-current={t.current ? 'true' : undefined}>{t.label}</a>
        ))}
      </nav>
      <!-- Narrow screens: the same choices as a dropdown -->
      <details class="os-subtabs__menu">
        <summary>
          <span class="os-subtabs__current">{subtabs.find((t: any) => t.current)?.label ?? 'Overview'}</span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
        </summary>
        <ul>
          {subtabs.map((t: any) => (
            <li>
              <a href={t.href} aria-current={t.current ? 'true' : undefined}>{t.label}</a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  )}
</div>

<script>
  document.addEventListener('click', (e) => {
    for (const d of document.querySelectorAll<HTMLDetailsElement>('details.os-subtabs__menu[open]'))
      if (!d.contains(e.target as Node)) d.open = false;
  });
</script>
