{
  "name": "@pimlock/openshell-docs-build",
  "version": "0.0.0",
  "description": "Build one repo's docs the way the OpenShell docs website shows them",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pimlock/openshell-docs.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "openshell-docs": "bin/openshell-docs.mjs"
  },
  "files": [
    "bin/",
    "assembler/",
    "scripts/docset.mjs",
    "scripts/redirects.mjs",
    "scripts/serve.mjs",
    "theme/",
    "site/",
    "!site/dist/",
    "!site/.astro/",
    "!site/node_modules/",
    "!site/public/",
    "!site/src/content/docs/",
    "!site/src/generated/",
    "!site/src/styles/tokens.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "assemble": "node assembler/assemble.mjs",
    "sync": "node site/scripts/sync.mjs",
    "build": "npm run assemble && npm run site",
    "site": "npm run sync && astro build --root site && node scripts/redirects.mjs site/dist",
    "dev": "npm run sync && astro dev --root site",
    "docset": "node scripts/docset.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "astro": "7.4.10",
    "github-slugger": "2.0.0",
    "pele": "1.13.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  }
}
